{
    // Zig snippets
    "zlox": {
        "scope": "zig",
        "prefix": "lib",
        "description": "Inserts a zlox root library import with a relative path.",
        "body": "const zlox = @import(\"${RELATIVE_FILEPATH/(src\\\\zlox\\\\[^\\\\]+\\\\[^\\\\]+.zig|(?:src\\\\zlox\\\\[^\\\\]+\\\\|(?:[^\\\\]+\\\\[^\\\\]+.zig|[^\\\\]+\\\\)))/..\\\//g}.lib.zig\");"
    },
    "Empty struct/tuple": {
        "scope": "zig",
        "prefix": "..",
        "description": "Inserts an empty struct/tuple, ready to be filled.",
        "body": ".{$1}",
    },
    "Struct @This() declaration": {
        "scope": "zig",
        "prefix": "this",
        "body": "const ${TM_FILENAME_BASE/(.+)/${1:/pascalcase}/}: type = @This();"
    },
    "Struct method": {
        "scope": "zig",
        "prefix": [
            "fn",
            "method",
            "meth",
        ],
        "body": [
            "fn ${1:name}(self: *${TM_FILENAME_BASE/(.+)/${1:/pascalcase}/}$2) ${3:void} {",
            "    $0",
            "}",
        ]
    },
    "Pub struct method": {
        "scope": "zig",
        "prefix": [
            "pubfn",
            "pubmethod",
            "pubmeth",
        ],
        "body": [
            "pub fn ${1:name}(self: *${TM_FILENAME_BASE/(.+)/${1:/pascalcase}/}$2) ${3:void} {",
            "    $0",
            "}",
        ]
    },
    "String ([]const u8)": {
        "scope": "zig",
        "prefix": "String",
        "body": "[]const u8",
    },
    "Section separator": {
        "scope": "zig",
        "prefix": "sep",
        "body": "// ============================================================================",
    },
    // JSON snippets
    "Escape JSON string": {
        "scope": "json,jsonc,snippets",
        "body": "${TM_SELECTED_TEXT/(?:(\\\\)|(\"))/${1:+\\\\\\\\}${2:+\\\\\"}/g}",
    },
    "Unescape JSON string": {
        "scope": "json,jsonc,snippets",
        "body": "${TM_SELECTED_TEXT/(?:(\\\\\\\\)|(\\\\\"))/${1:+\\\\}${2:+\"}/g}",
    },
}
